# このファイルを .env という名前でコピーし、値を書き込んでください。
# .env は git に入りません。キーをチャットに貼らないでください。

# Supabase の Project Settings → API で確認できる値（画面側で使ってよいもの）
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 注意: service_role key と Anthropic の API キーはここに書かない。
# Anthropic の API キーは Cloudflare Pages の環境変数（暗号化）に入れる。README を参照。
